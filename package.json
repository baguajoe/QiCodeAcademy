{
  "name": "qi-code-academy",
  "version": "0.1.0",
  "private": true,
  "description": "Qi Code Academy website (React frontend + Flask API). Run ./start.sh \u2014 not npm start.",
  "scripts": {
    "build": "webpack --config webpack.prod.js",
    "dev": "webpack serve --config webpack.dev.js",
