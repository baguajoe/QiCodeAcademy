# =====================================================================
# Qi Code Academy — environment variables
# Copy to .env for local dev:  cp .env.example .env
# On Render, set these in the dashboard (render.yaml lists them).
# Blank values fall back to safe dev defaults unless marked REQUIRED.
# Never commit a real .env.
# =====================================================================

# --- Core ------------------------------------------------------------
# development | production | testing. "production" enables strict checks,
# secure cookies, production CORS, and async email.
APP_ENV=development

# REQUIRED in production. Long random strings, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Dev: auto-generated per run if blank (admin logins reset on restart).
SECRET_KEY=
JWT_SECRET_KEY=
# Admin JWT lifetime in hours (default 8)
JWT_EXPIRES_HOURS=8

# REQUIRED in production. Postgres URL (postgres:// is accepted and rewritten).
# Blank in dev = SQLite at ./instance/dev.db
DATABASE_URL=

# Public site origin, no trailing slash. Used in emails, .ics links, and as
# the default production CORS origin.
SITE_URL=http://localhost:3001

# Extra allowed CORS origins, comma-separated. In development, Codespaces
# (*.app.github.dev) and localhost are always allowed. In production ONLY
# these (or SITE_URL if blank) are allowed.
CORS_ORIGINS=

# Where the built React app lives (webpack output). Default ./dist_manual
FRONTEND_DIST_DIR=

# --- Seed admin (flask seed) ---------------------------------------
# First admin account. Password must be at least 10 characters.
# Seeding never overwrites an existing admin's password.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# --- Email -----------------------------------------------------------
# Order: SendGrid if SENDGRID_API_KEY is set, else SMTP if SMTP_HOST is set,
# else (dev only) emails are printed to the console.
MAIL_FROM=Qi Code Academy <no-reply@qicodeacademy.org>
# Optional Reply-To for confirmations (e.g. a monitored inbox)
MAIL_REPLY_TO=
# Who receives "new submission" notifications (comma-separated). Blank = none.
ADMIN_NOTIFY_EMAIL=

SENDGRID_API_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# STARTTLS on port 587 (default true). Use SMTP_USE_SSL=true for port 465.
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Send emails on a background thread (default: true in production, false otherwise)
EMAIL_ASYNC=

# --- Stripe (donations) ---------------------------------------------
# Secret key: sk_test_... in dev, sk_live_... in production.
STRIPE_SECRET_KEY=
# Webhook signing secret (whsec_...). Locally: `stripe listen --forward-to localhost:3001/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET=
# Where Stripe sends donors after paying / cancelling. `?session_id={CHECKOUT_SESSION_ID}`
# is appended to the success URL automatically.
STRIPE_SUCCESS_URL=http://localhost:3001/donate/thank-you
STRIPE_CANCEL_URL=http://localhost:3001/donate
STRIPE_CURRENCY=usd
# Donation limits in cents (defaults $1 and $25,000)
DONATION_MIN_CENTS=100
DONATION_MAX_CENTS=2500000

# --- Cloudflare R2 (image storage) ----------------------------------
# All five must be set to use R2; otherwise images are saved to ./uploads
# (fine for dev; Render's disk is wiped on deploy, so use R2 in production).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL of the bucket (r2.dev URL or custom domain), no trailing slash
R2_PUBLIC_URL=
# Local fallback folder (default ./uploads)
UPLOAD_FOLDER=

# --- Rate limiting ---------------------------------------------------
RATELIMIT_ENABLED=true
# memory:// is per-process. Use redis://... if you run several instances.
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_FORMS=5 per minute;30 per hour
RATELIMIT_DONATIONS=10 per minute;60 per hour
RATELIMIT_LOGIN=10 per minute;50 per hour

# --- Dev launcher (./start.sh) --------------------------------------
PORT=3001
# NO_RELOAD=1     skip Flask's auto-reloader (saves ~100 MB RAM)
# SKIP_WEBPACK=1  run the API only
